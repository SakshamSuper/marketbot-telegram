# ─────────────────────────────────────────────────────────
# TELEGRAM
# ─────────────────────────────────────────────────────────
# Get from @BotFather → /newbot
BOT_TOKEN=your_telegram_bot_token_here

# Get from @userinfobot on Telegram
CHAT_ID=your_numeric_chat_id_here

# ─────────────────────────────────────────────────────────
# GEMINI AI  (free tier: 1500 req/day)
# Get from: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ─────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────
WEBHOOK_SECRET=change_me_to_a_random_string

# ─────────────────────────────────────────────────────────
# WATCHLISTS  (comma-separated, no spaces)
# ─────────────────────────────────────────────────────────

# Indian stocks: use .NS suffix for NSE, .BO for BSE
INDIAN_STOCKS=RELIANCE.NS,TCS.NS,INFY.NS,HDFCBANK.NS,ICICIBANK.NS,WIPRO.NS,BAJFINANCE.NS

# US stocks
US_STOCKS=AAPL,TSLA,GOOGL,MSFT,NVDA

# CoinGecko coin IDs (https://api.coingecko.com/api/v3/coins/list)
CRYPTO_IDS=bitcoin,ethereum,solana

# ─────────────────────────────────────────────────────────
# SMART ALERTS
# ─────────────────────────────────────────────────────────

# Only alert when price moves more than this % (default: 2%)
PRICE_CHANGE_THRESHOLD_PCT=2.0

# Don't re-alert the same stock within this many hours
ALERT_COOLDOWN_HOURS=4.0

# How often to poll prices for smart alerts (seconds)
ALERT_POLL_INTERVAL=300

# ─────────────────────────────────────────────────────────
# SCHEDULE  (IST — Asia/Kolkata timezone)
# ─────────────────────────────────────────────────────────
SCHEDULE_PREMARKET_HOUR=8
SCHEDULE_PREMARKET_MIN=0
SCHEDULE_OPEN_HOUR=9
SCHEDULE_OPEN_MIN=15
SCHEDULE_EVENING_HOUR=20
SCHEDULE_EVENING_MIN=0

# ─────────────────────────────────────────────────────────
# NEWS & POLYMARKET
# ─────────────────────────────────────────────────────────
NEWS_MAX_PER_SOURCE=3
POLYMARKET_TOP_N=5

# ─────────────────────────────────────────────────────────
# SERVER (Railway injects PORT automatically)
# ─────────────────────────────────────────────────────────
PORT=8080
